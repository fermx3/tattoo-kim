# Copia este archivo a .env.local y rellena los valores.
# .env.local está en .gitignore y nunca debe commitearse.

# Google Places API — reseñas y rating de las dos sucursales.
# Opcional en desarrollo: sin estas variables el sitio usa FALLBACK_DATA
# (src/lib/google-reviews.ts) y el build sale igual de limpio.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID_PDC=
GOOGLE_PLACE_ID_CUN=

# Bearer token que protege GET /api/cron. Sólo necesario en producción,
# donde Vercel lo envía al refrescar la caché de reseñas una vez al mes.
CRON_SECRET=
